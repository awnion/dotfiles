// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "ui_font_weight": 500.0,
  "cli_default_open_behavior": "existing_window",
  "show_edit_predictions": false,
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "disable_ai": false,
  "agent_buffer_font_size": 15.0,
  "ui_font_size": 14.0,
  "buffer_font_weight": 400.0,
  "git_panel": {
    "dock": "right",
    "sort_by_path": true,
    "tree_view": true,
  },
  "agent_servers": {
    "mistral-vibe": {
      "type": "registry",
    },
    "corust-agent": {
      "type": "registry",
    },
    "poolside": {
      "type": "registry",
    },
    "qwen-code": {
      "type": "registry",
    },
    "junie": {
      "default_config_options": {
        "model": "gpt-5.5",
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high",
        "mode": "agent-full-access",
        "model": "gpt-5.6-sol",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "model": "gpt-5.6-sol",
      },
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "model": "openai/gpt-5.6-sol",
      },
      "favorite_models": ["llama-local/Omnicoder / Qwen 3.5 9B"],
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "icon_theme": "Catppuccin Latte",
  "language_models": {
    "anthropic_compatible": {
      "Claude GPT": {
        "api_url": "http://127.0.0.1:8317",
        "available_models": [
          {
            "name": "gpt-5.6-sol",
            "max_tokens": 270000,
            "max_output_tokens": 64000,
            "extra_beta_headers": [],
            "capabilities": {
              "tools": true,
              "images": true,
              "prompt_caching": false
            }
          }
        ]
      }
    },
    "ollama": {
      "api_url": "http://127.0.0.1:11434",
    },
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://api\\.github\\.com",
            },
          ],
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^cargo\\s+\\+nightly(\\s|$)",
            },
            {
              "pattern": "^cargo\\s+clippy(\\s|$)",
            },
            {
              "pattern": "^git\\b",
            },
            {
              "pattern": "^sed\\b",
            },
            {
              "pattern": "^rg\\s+setup-mold(\\s|$)",
            },
          ],
        },
      },
    },
    "dock": "left",
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-terra",
      "enable_thinking": false,
    },
    "inline_assistant_use_streaming_tools": false,
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
    },
  },
  "file_types": {
    "Dockerfile": ["Dockerfile", "*.Dockerfile", "*.dockerfile"],
    "Ansible": [
      "ansible/**/*.yaml",
      "ansible/**/*.yml",
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/host_vars/*.yml",
      "**/host_vars/*.yaml",
      "**/playbooks/*.yml",
      "**/playbooks/*.yaml",
      "**playbook*.yml",
      "**playbook*.yaml",
    ],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": "Gruvbox Dark",
  "buffer_font_size": 16,
  "buffer_font_family": "afio",
  "vim_mode": true,
  "inlay_hints": {
    // "enabled": true
  },
  "vim": {
    "use_system_clipboard": "always",
  },
  "format_on_save": "on",
  "lsp": {
    "cargo-tom": {
      "initialization_options": {
        /// Search
        "per_page": 25,
        /// What features should be displayed on hover
        /// All, UnusedOpt, Features,
        "feature_display_mode": "UnusedOpt",
        "hide_docs_info_message": true,
        /// Sort toml on format
        "sort_format": false,
        /// Use stable versions in completions
        "stable_version": true,
        /// Offline mode uses https://github.com/frederik-uni/crates.io-dump-minfied for search
        /// The order is non existent feel free to contribute
        "offline": false,
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "enable": "true",
            "bracketSpacing": "true",
          },
        },
      },
    },
  },
  "languages": {
    "YAML": {
      "formatter": "language_server",
    },
    "Python": {
      "language_servers": [
        // Disable basedpyright and enable ty, and otherwise
        // use the default configuration.
        "ty",
        "!basedpyright",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
}
